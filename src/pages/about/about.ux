<template>
  <div class="page download-page" @swipe="toHomePage">
    <div class="header column center">
      <text class="a">{{ $t('title.about') }}</text>
    </div>
    <text class="time">{{ time }}</text>

    <image class="icon" src="/common/icon/something.png"></image>

    <text class="people">参与开发的人员</text>
    <text class="ren">@Dreamqiu</text>

    <text class="people2">二次开发的人员</text>
    <text class="ren2">@JIFENG @ziqianou @dargon</text>

    <text class="people3">设计参考</text>
    <text class="ren3">@无源流沙</text>

    <input
      class="but"
      type="button"
      value="{{ $t('action.more') }}"
      style="font-size: 19px; color: #ffffff"
      onclick="more"
    />
  </div>
</template>

<script>
import router from "@system.router"
import clock from "../../common/clock.js"

export default {
  private: {
    time: "00:00"
  },
  onInit() {
    this.timer = clock.startClock((t) => {
      this.time = t
    })
  },
  onDestroy() {
    clearInterval(this.timer)
  },
  more() {
    router.push({
      uri: "/pages/more"
    })
  },
  toHomePage(eve) {
    if (eve.direction === "right") {
      router.replace({
        uri: "/pages/index"
      })
    }
  }
}
</script>

