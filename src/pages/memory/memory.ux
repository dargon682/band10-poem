<template>
  <div class="page">
    <div class="header row">
      <text class="title">{{ $t('title.memory') }}</text>
    </div>
    <text class="time">{{ time }}</text>
    <text class="progress">{{ progress }}</text>

    <scroll class="list" scroll-y="true" bounces="true">
      <text class="sec" if="{{due.length > 0}}">{{ dueTitle }}</text>
      <div class="row item" for="{{due}}" tid="key">
        <input class="act" type="button" value="√" @click="finish($item)" />
        <text class="nm" @click="openItem($item)">{{ $item.name }}</text>
        <text class="gd">{{ $item.grade }}</text>
      </div>

      <text class="sec" if="{{learning.length > 0}}">{{ learningTitle }}</text>
      <div class="row item" for="{{learning}}" tid="key">
        <text class="nm" @click="openItem($item)">{{ $item.name }}</text>
        <text class="gd">{{ $item.remain }}</text>
      </div>

      <text class="sec" if="{{finished.length > 0}}">{{ doneTitle }}</text>
      <div class="row item" for="{{finished}}" tid="key">
        <text class="chk">√</text>
        <text class="nm" @click="openItem($item)">{{ $item.name }}</text>
        <text class="gd">{{ $item.grade }}</text>
      </div>

      <text class="tip" if="{{empty}}">{{ $t('mem.empty') }}</text>
      <div class="pad"></div>
    </scroll>

    <image class="back" src="/common/icon/back.png" onclick="back"></image>
  </div>
</template>

<script>
import router from "@system.router"
import grades from "../../common/grades.js"
import store from "../../common/store.js"
import ebb from "../../common/ebbinghaus.js"
import clock from "../../common/clock.js"

export default {
  private: {
    time: "00:00",
    progress: "",
    dueTitle: "",
    learningTitle: "",
    doneTitle: "",
    due: [],
    learning: [],
    finished: [],
    empty: false,
    all: [],
    // 进入页面时读出的记忆计划内存副本，所有变更只改副本，落盘只写不读
    map: {}
  },
  onInit() {
    this.all = grades.getAllPoems()
    this.dueTitle = this.$t("mem.due")
    this.learningTitle = this.$t("mem.learning")
    this.doneTitle = this.$t("mem.done")
    this.refresh()

    this.timer = clock.startClock((t) => {
      this.time = t
    })
  },
  onDestroy() {
    clearInterval(this.timer)
  },
  // 一次性读出全量计划到内存副本，之后只基于副本渲染
  refresh() {
    store.getMemoryMap((map) => {
      this.map = map
      this.build()
    })
  },
  // 依据艾宾浩斯排程把全部篇目分为：今日待复习 / 背诵中 / 已完成
  build() {
    const map = this.map
    const now = Date.now()
    const due = []
    const learning = []
    const finished = []
    let doneCount = 0
    for (let i = 0; i < this.all.length; i++) {
      const p = this.all[i]
      const plan = map[store.poemKey(p.grade, p.name)]
      if (!plan) {
        continue
      }
      if (ebb.isFinished(plan)) {
        doneCount++
        finished.push({ name: p.name, grade: p.grade, remain: "" })
      } else if (ebb.isDue(plan, now)) {
        due.push({ name: p.name, grade: p.grade, remain: "" })
      } else {
        learning.push({ name: p.name, grade: p.grade, remain: ebb.remainText(plan, now) })
      }
    }
    this.due = due
    this.learning = learning
    this.finished = finished
    this.empty = due.length === 0 && learning.length === 0 && finished.length === 0
    this.progress = this.$t("mem.done") + " " + doneCount + "/" + this.all.length + " · " + this.$t("mem.learning") + " " + learning.length
  },
  // 完成本轮复习，推进到下一轮间隔（只改内存副本 + 只写落盘，避免回读竞态）
  finish(item) {
    const key = store.poemKey(item.grade, item.name)
    const plan = this.map[key]
    if (!plan) {
      return
    }
    const next = {}
    for (const k in this.map) {
      if (this.map[k] !== undefined) {
        next[k] = this.map[k]
      }
    }
    next[key] = ebb.advance(plan)
    this.map = next
    store.saveMemoryMap(next)
    this.build()
  },
  openItem(item) {
    router.push({
      uri: "/pages/poem",
      params: { text: item.name, which: item.grade }
    })
  },
  back() {
    router.back()
  }
}
</script>

<style>
@import "../../common/style.css";

.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  width: 100%;
  background-color: #000000;
  position: absolute;
}

.header {
  width: 100%;
  height: 46px;
  align-items: center;
}

.title {
  font-size: 22px;
  color: #ffffff;
  /* 让出左上角返回键的位置，避免文字与返回键叠在一起 */
  margin-left: 56px;
}

.time {
  font-size: 15px;
  color: rgba(255, 255, 255, 0.55);
  margin-left: 8px;
}

.progress {
  font-size: 14px;
  color: #9fd18b;
  margin-left: 8px;
  margin-bottom: 4px;
}

.list {
  position: absolute;
  left: 0;
  top: 94px;
  bottom: 34px;
  width: 100%;
}

.sec {
  font-size: 14px;
  color: #8a8a8a;
  margin-left: 10px;
  margin-top: 8px;
  margin-bottom: 4px;
}

.item {
  width: 97%;
  height: 44px;
  margin-left: 4px;
  margin-bottom: 6px;
  border-radius: 22px;
  background-color: rgba(255, 255, 255, 0.1);
  padding-left: 8px;
  padding-right: 12px;
  align-items: center;
}

/* 篇名/年级均给显式宽度：Vela 中仅靠 flex:1 会被压成 0 宽，篇名就看不见了 */
.nm {
  width: 78px;
  font-size: 16px;
  color: #ffffff;
  text-overflow: ellipsis;
  lines: 1;
}

.gd {
  width: 68px;
  font-size: 12px;
  color: #9a9a9a;
  text-align: right;
  text-overflow: ellipsis;
  lines: 1;
}

.act {
  width: 30px;
  height: 34px;
  border-radius: 17px;
  margin-right: 6px;
  font-size: 16px;
  color: #ffffff;
  background-color: rgba(120, 200, 120, 0.5);
}

.chk {
  width: 30px;
  font-size: 16px;
  color: #9fd18b;
  margin-right: 6px;
  text-align: center;
}

/* 空状态提示：显式限定宽度并留出左右边距，避免长句右侧被屏幕裁掉 */
.tip {
  width: 176px;
  margin-left: 18px;
  font-size: 14px;
  color: #8a8a8a;
  text-align: center;
  margin-top: 30px;
}

.pad {
  height: 12px;
}

.back {
  position: absolute;
  left: 14px;
  top: 16px;
  width: 40px;
  height: 40px;
  opacity: 0.6;
}
</style>
