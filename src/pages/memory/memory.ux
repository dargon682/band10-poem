  font-size: 15px;
  color: rgba(255, 255, 255, 0.55);
  margin-left: 8px;
}

.progress {
  font-size: 14px;
  color: #9fd18b;
  margin-left: 8px;
  margin-bottom: 4px;
}

.list {
  position: absolute;
  left: 0;
  top: 94px;
  bottom: 10px;
  width: 100%;
}

.sec {
  font-size: 14px;
  color: #8a8a8a;
  margin-left: 10px;
  margin-top: 8px;
  margin-bottom: 4px;
}

.item {
  width: 96%;
  height: 44px;
  margin-left: 4px;
  margin-bottom: 6px;
  border-radius: 22px;
  background-color: rgba(255, 255, 255, 0.1);
  padding-left: 8px;
  padding-right: 12px;
  align-items: center;
}

.nm {
  flex: 1;
  font-size: 17px;
  color: #ffffff;
  text-overflow: ellipsis;
}

.gd {
  font-size: 12px;
  color: #9a9a9a;
  margin-left: 6px;
}

.act {
  width: 30px;
  height: 34px;
  border-radius: 17px;
  margin-right: 6px;
  font-size: 16px;
  color: #ffffff;
  background-color: rgba(120, 200, 120, 0.5);
}

.chk {
  width: 30px;
  font-size: 16px;
  color: #9fd18b;
  margin-right: 6px;
  text-align: center;
}

.tip {
  width: 100%;
  font-size: 14px;
  color: #8a8a8a;
  text-align: center;
  margin-top: 30px;
}

.pad {
  height: 12px;
}

.back {
  position: absolute;
  left: 4px;
  top: 4px;
  width: 42px;
  height: 42px;
  opacity: 0.6;
}
</style>
