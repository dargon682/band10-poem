<template>
  <div class="page" @swipe="onSwipe">
    <!-- 正文滚动区：绝对定位 + 显式高度，只在自身区域内滚动，不压住顶部篇名、不动底部按钮 -->
    <scroll class="box" scroll-y="true" bounces="true">
      <div class="padtop"></div>
      <div class="card column center">
        <text class="a">{{ people }}</text>
        <text class="b" style="font-size: {{ size }}px; line-height: {{ lineHeight }}px">{{ poem }}</text>
      </div>
      <div class="padbottom"></div>
    </scroll>

    <image class="cover" src="/common/icon/cover.png"></image>
    <text class="time">{{ time }}</text>
    <text class="title">{{ text }}</text>
    <image class="back" src="/common/icon/back.png" onclick="back"></image>

    <!-- 记忆计划状态；到期时出现“完成本轮” -->
    <div class="row status">
      <text class="stxt">{{ status }}</text>
      <input class="act" if="{{ canReview }}" type="button" value="{{ reviewLabel }}" @click="review" />
    </div>

    <!-- 底部操作：对勾框 / 收藏 / 字号 -->
    <div class="row toolbar">
      <div class="tbtn markbox" @click="toggleMark">
        <text class="glyph" style="color: {{ markColor }}">{{ markText }}</text>
      </div>
      <div class="tbtn" @click="toggleFav">
        <text class="glyph" style="color: {{ favColor }}">{{ favText }}</text>
      </div>
      <div class="tbtn" @click="smaller">
        <text class="glyph tiny">A-</text>
      </div>
      <div class="tbtn" @click="bigger">
        <text class="glyph tiny">A+</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import grades from "../../common/grades.js"
import poems from "../../common/poem.js"
import store from "../../common/store.js"
import ebb from "../../common/ebbinghaus.js"
import clock from "../../common/clock.js"

const MIN_SIZE = 20
const MAX_SIZE = 34
const RECENT_MAX = 10
// 未加入记忆计划时对勾用近黑灰（视觉上等同空框），已加入后变绿
const CHECK_OFF = "#2b2b2b"
const CHECK_ON = "#9fd18b"

function cloneMap(src) {
  const out = {}
  for (const k in src) {
    if (src[k] !== undefined) {
      out[k] = src[k]
    }
  }
  return out
}

export default {
  // 页面级组件的数据模型，影响传入数据的覆盖机制：private内定义的属性不允许被覆盖
  private: {
    time: "00:00",
    people: "",
    poem: "",
    text: "古诗",
    which: "",
    size: 26,
    lineHeight: 42,
    favText: "☆",
    favColor: "#cccccc",
    names: [],
    idx: 0,
    markText: "√",
    markColor: CHECK_OFF,
    status: "",
    canReview: false,
    reviewLabel: "完成本轮",
    // 进入页面时一次性读出的内存副本；之后所有切换只改副本，落盘只写不读，
    // 避免 @system.storage「写入后立即回读」拿到旧值导致界面不刷新
    favs: [],
    recent: [],
    memMap: {}
  },
  onInit() {
    this.reviewLabel = this.$t("action.review")
    // 本学期篇目名列表，用于上/下篇定位
    this.names = grades.getPoemNames(this.which)
    for (let i = 0; i < this.names.length; i++) {
      if (this.names[i] === this.text) {
        this.idx = i
        break
      }
    }

    store.getFontSize((size) => {
      this.size = size
      this.lineHeight = Math.round(size * 1.6)
    })

    store.getCaches((c) => {
      this.favs = c.favs || []
      this.recent = c.recent || []
      this.memMap = c.memMap || {}
      this.applyCurrent()
    })

    this.timer = clock.startClock((t) => {
      this.time = t
    })
  },
  onDestroy() {
    clearInterval(this.timer)
  },
  // 加载当前篇目正文，并同步收藏状态、最近阅读与记忆计划
  applyCurrent() {
    const item = poems.getPoem(this.which, this.text)
    this.people = item ? item.author : ""
    this.poem = item ? item.content : "暂无内容"
    this.refreshFav()
    this.recordRecent()
    this.refreshPlan()
  },
  // ---------- 收藏：只改内存副本 + 只写落盘 ----------
  isFaved() {
    for (let i = 0; i < this.favs.length; i++) {
      if (this.favs[i].grade === this.which && this.favs[i].name === this.text) {
        return true
      }
    }
    return false
  },
  refreshFav() {
    const on = this.isFaved()
    this.favText = on ? "★" : "☆"
    this.favColor = on ? "#ffd166" : "#cccccc"
  },
  toggleFav() {
    const arr = this.favs.slice()
    let index = -1
    for (let i = 0; i < arr.length; i++) {
      if (arr[i].grade === this.which && arr[i].name === this.text) {
        index = i
        break
      }
    }
    if (index >= 0) {
      arr.splice(index, 1)
    } else {
      arr.push({ grade: this.which, name: this.text })
    }
    this.favs = arr
    store.saveFavorites(arr)
    this.refreshFav()
  },
  // ---------- 最近阅读：去重置顶，最多 10 条 ----------
  recordRecent() {
    const next = [{ grade: this.which, name: this.text }]
    for (let i = 0; i < this.recent.length; i++) {
      const r = this.recent[i]
      if (!(r.grade === this.which && r.name === this.text)) {
        next.push(r)
      }
    }
    this.recent = next.slice(0, RECENT_MAX)
    store.saveRecent(this.recent)
  },
  // ---------- 记忆计划：只改内存副本 + 只写落盘 ----------
  refreshPlan() {
    const plan = this.memMap[store.poemKey(this.which, this.text)]
    const now = Date.now()
    this.canReview = ebb.isDue(plan, now)
    this.markText = "√"
    if (!plan) {
      this.markColor = CHECK_OFF
      this.status = this.$t("mem.none")
    } else {
      this.markColor = CHECK_ON
      if (ebb.isFinished(plan)) {
        this.status = ebb.TOTAL + "/" + ebb.TOTAL + "轮 · 已背完"
      } else {
        this.status = plan.step + 1 + "/" + ebb.TOTAL + "轮 · " + ebb.remainShort(plan, now)
      }
    }
  },
  // 打对勾：勾选标记已背完并开始遗忘曲线排程，取消则移出计划
  toggleMark() {
    const key = store.poemKey(this.which, this.text)
    const map = cloneMap(this.memMap)
    if (map[key]) {
      delete map[key]
    } else {
      map[key] = ebb.createPlan(Date.now())
    }
    this.memMap = map
    store.saveMemoryMap(map)
    this.refreshPlan()
  },
  // 完成本轮复习，推进到下一轮间隔
  review() {
    const key = store.poemKey(this.which, this.text)
    const plan = this.memMap[key]
    if (!plan) {
      return
    }
    const map = cloneMap(this.memMap)
    map[key] = ebb.advance(plan)
    this.memMap = map
    store.saveMemoryMap(map)
    this.refreshPlan()
  },
  // 切换上/下一篇（不重建页面，避免路由栈堆积）
  go(offset) {
    const next = this.idx + offset
    if (next < 0 || next >= this.names.length) {
      return
    }
    this.idx = next
    this.text = this.names[next]
    this.applyCurrent()
  },
  onSwipe(eve) {
    if (eve.direction === "left") {
      this.go(1)
    } else if (eve.direction === "right") {
      this.go(-1)
    }
  },
  smaller() {
    if (this.size > MIN_SIZE) {
      this.setSize(this.size - 2)
    }
  },
  bigger() {
    if (this.size < MAX_SIZE) {
      this.setSize(this.size + 2)
    }
  },
  setSize(size) {
    this.size = size
    this.lineHeight = Math.round(size * 1.6)
    store.setFontSize(size)
  },
  back() {
    router.back()
  }
}
</script>

<style>
@import "../../common/style.css";

  .page {
    align-items: center;
    background-color: #000000;
    flex: 1;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: absolute;
    width: 100%;
  }

  .title {
    position: absolute;
    color: rgba(255, 255, 255, 1);
    font-size: 19px;
    font-weight: 500;
    line-height: 28px;
    text-align: center;
    width: 70%;
    left: 15%;
    top: 38px;
  }

  /* 正文滚动区：显式给出左边界、上边界与高度，
     既不被滚动内容顶穿到顶部篇名，也不延伸到下方状态行/按钮行 */
  .box {
    position: absolute;
    left: 8px;
    top: 68px;
    width: 196px;
    height: 330px;
  }

  .padtop {
    height: 8px;
  }

  /* 尾部留白需大于一行（最大字号下行高 54px），避免滚到底时末行被视口下边缘切半截 */
  .padbottom {
    height: 60px;
  }

  .card {
    width: 100%;
    border: 2px solid rgba(255, 255, 255, 0.06);
    border-radius: 24px;
    background-color: rgba(255, 255, 255, 0.2);
    color: #fff;
    padding: 10px;
  }

  .a {
    font-size: 22px;
    color: #c5c5c5;
    margin-bottom: 13px;
    width: 100%;
    text-align: center;
  }

  .b {
    color: #ffffff;
    width: 100%;
    text-align: center;
  }

  .back {
    position: absolute;
    left: 14px;
    top: 16px;
    width: 40px;
    height: 40px;
    opacity: 0.55;
  }

  /* 记忆计划状态行 */
  .status {
    position: absolute;
    left: 14px;
    width: 184px;
    bottom: 90px;
    height: 26px;
    align-items: center;
  }

  .stxt {
    flex: 1;
    font-size: 12px;
    color: #9fd18b;
    text-overflow: ellipsis;
  }

  .act {
    width: 76px;
    height: 26px;
    border-radius: 13px;
    color: #ffffff;
    background-color: rgba(120, 200, 120, 0.5);
  }

  /* 底部按钮行：整体上移、向内收，避开胶囊屏底部圆角，尺寸放大便于点按 */
  .toolbar {
    position: absolute;
    left: 16px;
    width: 180px;
    bottom: 40px;
    height: 42px;
    align-items: center;
    justify-content: space-between;
  }

  .tbtn {
    display: flex;
    width: 40px;
    height: 42px;
    border-radius: 21px;
    background-color: rgba(255, 255, 255, 0.16);
    justify-content: center;
    align-items: center;
  }

  /* 打对勾的框：描边即未勾选，勾选后显示绿色对勾 */
  .markbox {
    border: 2px solid rgba(255, 255, 255, 0.45);
  }

  .glyph {
    font-size: 19px;
    text-align: center;
  }

  .tiny {
    font-size: 15px;
    color: #ffffff;
  }
</style>
