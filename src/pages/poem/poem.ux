<template>
  <div class="page" @swipe="onSwipe">
    <!-- 正文滚动区：绝对定位限定高度，避免正文溢出屏幕 -->
    <scroll class="column box center" scroll-y="true" bounces="true">
      <div class="item1"></div>

      <div class="description footer column center">
        <text class="a">{{ people }}</text>
        <text class="b" style="font-size: {{ size }}px; line-height: {{ lineHeight }}px">{{ poem }}</text>
      </div>

      <div class="item1"></div>
    </scroll>

    <image class="cover" src="/common/icon/cover.png"></image>
    <text class="time">{{ time }}</text>

    <text class="title">{{ text }}</text>
    <image class="back" src="/common/icon/back.png" onclick="back"></image>

    <!-- 记忆计划状态；到期时出现“完成本轮” -->
    <div class="row status">
      <text class="stxt">{{ status }}</text>
      <input class="act" if="{{ canReview }}" type="button" value="{{ reviewLabel }}" style="font-size: 13px" @click="review" />
    </div>

    <!-- 底部操作：对勾框 / 收藏 / 字号 -->
    <div class="row toolbar">
      <div class="tbtn markbox" @click="toggleMark">
        <text class="glyph" style="color: {{ markColor }}">{{ markText }}</text>
      </div>
      <div class="tbtn" @click="toggleFav">
        <text class="glyph" style="color: {{ favColor }}">{{ favText }}</text>
      </div>
      <div class="tbtn" @click="smaller">
        <text class="glyph tiny">A-</text>
      </div>
      <div class="tbtn" @click="bigger">
        <text class="glyph tiny">A+</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import grades from "../../common/grades.js"
import poems from "../../common/poem.js"
import store from "../../common/store.js"
import ebb from "../../common/ebbinghaus.js"
import clock from "../../common/clock.js"

const MIN_SIZE = 20
const MAX_SIZE = 34

export default {
  // 页面级组件的数据模型，影响传入数据的覆盖机制：private内定义的属性不允许被覆盖
  private: {
    time: "00:00",
    people: "",
    poem: "",
    text: "古诗",
    which: "",
    size: 26,
    lineHeight: 42,
    isFav: false,
    favText: "☆",
    favColor: "#cccccc",
    names: [],
    idx: 0,
    marked: false,
    markText: "",
    markColor: "#8a8a8a",
    status: "",
    canReview: false,
    reviewLabel: "完成本轮"
  },
  onInit() {
    this.reviewLabel = this.$t("action.review")
    // 本学期篇目名列表，用于上/下篇定位
    this.names = grades.getPoemNames(this.which)
    for (let i = 0; i < this.names.length; i++) {
      if (this.names[i] === this.text) {
        this.idx = i
        break
      }
    }
    this.applyCurrent()

    store.getFontSize((size) => {
      this.size = size
      this.lineHeight = Math.round(size * 1.6)
    })

    this.timer = clock.startClock((t) => {
      this.time = t
    })
  },
  onDestroy() {
    clearInterval(this.timer)
  },
  // 加载当前篇目正文，并同步收藏状态、最近阅读与记忆计划
  applyCurrent() {
    const item = poems.getPoem(this.which, this.text)
    this.people = item ? item.author : ""
    this.poem = item ? item.content : "暂无内容"

    store.isFavorite(this.which, this.text, (fav) => {
      this.isFav = fav
      this.favText = fav ? "★" : "☆"
      this.favColor = fav ? "#ffd166" : "#cccccc"
    })
    store.pushRecent(this.which, this.text)
    this.syncPlan()
  },
  // 同步本篇的复习计划状态
  syncPlan() {
    store.getPlan(this.which, this.text, (plan) => {
      const now = Date.now()
      this.canReview = ebb.isDue(plan, now)
      if (!plan) {
        this.marked = false
        this.markText = ""
        this.markColor = "#8a8a8a"
        this.status = this.$t("mem.none")
      } else {
        this.marked = true
        this.markText = "✓"
        this.markColor = "#9fd18b"
        if (ebb.isFinished(plan)) {
          this.status = ebb.TOTAL + "/" + ebb.TOTAL + "轮 · 已背完"
        } else {
          this.status = plan.step + 1 + "/" + ebb.TOTAL + "轮 · " + ebb.remainShort(plan, now)
        }
      }
    })
  },
  // 打对勾：勾选标记已背完并开始遗忘曲线排程，取消则移出计划
  toggleMark() {
    if (this.marked) {
      store.removePlan(this.which, this.text, () => {
        this.syncPlan()
      })
    } else {
      store.setPlan(this.which, this.text, ebb.createPlan(Date.now()), () => {
        this.syncPlan()
      })
    }
  },
  // 完成本轮复习
  review() {
    store.getPlan(this.which, this.text, (plan) => {
      if (plan) {
        store.setPlan(this.which, this.text, ebb.advance(plan), () => {
          this.syncPlan()
        })
      }
    })
  },
  // 切换上/下一篇（不重建页面，避免路由栈堆积）
  go(offset) {
    const next = this.idx + offset
    if (next < 0 || next >= this.names.length) {
      return
    }
    this.idx = next
    this.text = this.names[next]
    this.applyCurrent()
  },
  onSwipe(eve) {
    if (eve.direction === "left") {
      this.go(1)
    } else if (eve.direction === "right") {
      this.go(-1)
    }
  },
  toggleFav() {
    store.toggleFavorite(this.which, this.text, (fav) => {
      this.isFav = fav
      this.favText = fav ? "★" : "☆"
      this.favColor = fav ? "#ffd166" : "#cccccc"
    })
  },
  smaller() {
    if (this.size > MIN_SIZE) {
      this.setSize(this.size - 2)
    }
  },
  bigger() {
    if (this.size < MAX_SIZE) {
      this.setSize(this.size + 2)
    }
  },
  setSize(size) {
    this.size = size
    this.lineHeight = Math.round(size * 1.6)
    store.setFontSize(size)
  },
  back() {
    router.back()
  }
}
</script>

<style>
@import "../../common/style.css";

  .item1 {
    height: 26px;
    margin-top: 6px;
    margin-bottom: 6px;
    border-radius: 9px;
  }

  .center {
    align-items: center;
  }

  .page {
    align-items: center;
    background-color: #000000;
    flex: 1;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: absolute;
    width: 100%;
  }

  .title {
    position: absolute;
    color: rgba(255, 255, 255, 1);
    font-size: 19px;
    font-weight: 500;
    line-height: 28px;
    text-align: center;
    width: 70%;
    left: 15%;
    top: 32px;
  }

  .a {
    font-size: 22px;
    color: #c5c5c5;
    margin-bottom: 13px;
  }

  .b {
    color: #ffffff;
  }

  /* 正文区：绝对定位 + 上下边界，保证正文只在可视区内滚动 */
  .box {
    position: absolute;
    left: 3px;
    top: 46px;
    bottom: 100px;
    width: 97%;
  }

  .description {
    border: 2px solid rgba(255, 255, 255, 0.06);
    border-radius: 25px;
    background-color: rgba(255, 255, 255, 0.2);
    color: #fff;
    padding: 9px;
    font-size: 9px;
    margin: 0 auto;
  }

  .back {
    position: absolute;
    left: 4px;
    top: 4px;
    width: 45px;
    height: 45px;
    opacity: 0.5;
  }

  /* 记忆计划状态行 */
  .status {
    position: absolute;
    left: 10px;
    width: 192px;
    bottom: 62px;
    height: 30px;
    align-items: center;
  }

  .stxt {
    flex: 1;
    font-size: 12px;
    color: #9fd18b;
    text-overflow: ellipsis;
  }

  .act {
    width: 78px;
    height: 28px;
    border-radius: 14px;
    color: #ffffff;
    background-color: rgba(120, 200, 120, 0.5);
  }

  /* 底部按钮行：加宽加高，便于点按 */
  .toolbar {
    position: absolute;
    left: 9px;
    width: 194px;
    bottom: 16px;
    height: 40px;
    align-items: center;
    justify-content: space-between;
  }

  .tbtn {
    display: flex;
    width: 45px;
    height: 40px;
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.16);
    justify-content: center;
    align-items: center;
  }

  /* 打对勾的框：描边即未勾选，勾选后显示绿色对勾 */
  .markbox {
    border: 2px solid rgba(255, 255, 255, 0.45);
  }

  .glyph {
    font-size: 19px;
  }

  .tiny {
    font-size: 15px;
    color: #ffffff;
  }
</style>
